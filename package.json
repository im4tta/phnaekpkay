{
  "name": "phnaek-pkay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-based satellite imagery comparison and change review tool",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node tools/serve-dist.mjs --build && playwright test",
    "serve:dist": "node tools/serve-dist.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-khmer": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "onnxruntime-web": "1.31.1"
  }
}
